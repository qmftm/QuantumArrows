{
  "schemaVersion": 1,
  "id": "quantumarrows",
  "version": "${project.version}",
  "name": "QuantumArrows",
  "description": "Press a key (default: middle click) to open a radial picker of the arrows you carry. Point at one and release to move it into your target slot.",
  "authors": [
    "qmftm"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.quantumarrows.client.QuantumArrowsClient"
    ],
    "modmenu": [
      "com.quantumarrows.client.QuantumArrowsModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-mapping-api-v1": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
